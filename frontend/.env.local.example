# Copier vers .env.local — ne jamais committer .env.local
# Le backend tourne sur 3000, le frontend sur 3001 (voir README « Ports »)
#
# Deux valeurs acceptées :
#   http://localhost:3000/api   → appels directs au backend (recommandé)
#   /api                        → proxy Next.js vers le backend (rewrites)
# Une URL sans /api est complétée automatiquement.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optionnel : cible du proxy /api quand on utilise une URL relative.
# API_PROXY_TARGET=http://localhost:3000
