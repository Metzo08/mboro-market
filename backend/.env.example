BCRYPT_SALT_ROUNDS=12
SMS_PROVIDER=sandbox
SMS_API_KEY=
PAYDUNYA_API_KEY=
PAYDUNYA_API_TOKEN=
PAYDUNYA_INVOICE_KEY=
WAVE_API_KEY=
WEBHOOK_SECRET=
